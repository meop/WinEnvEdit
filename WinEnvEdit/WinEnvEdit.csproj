<Project Sdk="Microsoft.NET.Sdk">

  <!-- App identity & target platform -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>WinEnvEdit</AssemblyName>
    <Company>meop</Company>
    <Description>Modern Windows Environment Editor</Description>
    <ApplicationIcon>Assets\App.ico</ApplicationIcon>
    <ApplicationManifest>App.manifest</ApplicationManifest>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <Platforms>ARM64;x64</Platforms>
    <RuntimeIdentifiers>win-arm64;win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <!-- Language & compiler -->
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Custom entry point (Program.Main) so an elevated relaunch can apply system vars headless. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <!-- WinUI / Windows App SDK (mode-independent) -->
  <PropertyGroup>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WinUISDKReferences>true</WinUISDKReferences>
    <WebView2EnableCsWinRTProjection>false</WebView2EnableCsWinRTProjection>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKDeploymentManagerInitialize>false</WindowsAppSDKDeploymentManagerInitialize>
  </PropertyGroup>

  <!-- Deployment toggles: self-contained + Native AOT (set both false for the framework-dependent MSI) -->
  <PropertyGroup>
    <SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <!-- Derived from the toggles above (separate group so the conditions see the values set above) -->
  <PropertyGroup>
    <WindowsAppSDKSelfContained>$(SelfContained)</WindowsAppSDKSelfContained>
    <!-- self-contained bundles the runtime; the bootstrapper hunts for an installed one and fail-fasts (0xC0000602) -->
    <WindowsAppSDKBootstrapInitialize Condition="'$(SelfContained)' == 'true'">false</WindowsAppSDKBootstrapInitialize>
    <WindowsAppSDKBootstrapInitialize Condition="'$(SelfContained)' != 'true'">true</WindowsAppSDKBootstrapInitialize>
    <!-- AOT needs the CsWinRT optimizer; level 2 surfaces all AOT/trim binding warnings at build -->
    <CsWinRTAotOptimizerEnabled Condition="'$(PublishAot)' == 'true'">true</CsWinRTAotOptimizerEnabled>
    <CsWinRTAotWarningLevel Condition="'$(PublishAot)' == 'true'">2</CsWinRTAotWarningLevel>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>

  <!-- Release publish hygiene: stop the build from emitting/copying symbol files at the source. This is the bulk
       of the savings (~40 MB of .pdb); the TrimPublishOutput target below removes the smaller unused runtime
       payload. DebugType/DebugSymbols suppress the managed .pdb; AllowedReferenceRelatedFileExtensions stops the
       SDK from copying the .pdb/.xml that sit next to referenced assemblies; CopyOutputSymbolsToPublishDirectory
       drops the ~40 MB Native AOT .pdb. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
    <!-- Stop the Native AOT symbol file (the ~40 MB WinEnvEdit.pdb) from being copied into the publish folder.
         This gates the SDK's _CopyAotSymbols target. A post-publish Delete cannot remove it: _CopyAotSymbols runs
         AFTER AfterTargets="Publish", so the file is silently re-copied. Suppressing it at the source is the only
         thing that works. -->
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>WinEnvEdit.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <None Include="..\LICENSE.txt">
      <Link>LICENSE.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinEnvEdit.Core\WinEnvEdit.Core.csproj" />
  </ItemGroup>

  <!-- Bindings are made AOT-safe with the CsWinRT source generators ([GeneratedBindableCustomProperty],
       x:Bind). Those do NOT cover types reached only dynamically (code-hosted DataTemplates, converters and
       markup extensions resolved via XAML) — full trim strips them (e.g. path rows render as ToString()).
       WinUI offers no per-type alternative, so root the two small app assemblies: robust (covers every
       XAML-reached type) and cheap (the bulk of the bundle is the native WinUI runtime, which still trims). -->
  <ItemGroup Condition="'$(PublishAot)' == 'true'">
    <TrimmerRootAssembly Include="WinEnvEdit" />
    <TrimmerRootAssembly Include="WinEnvEdit.Core" />
  </ItemGroup>

  <!-- WinUI uses only the Core WebView2 assembly; the transitive WPF/WinForms WebView2 assemblies are built
       against legacy WindowsBase and cause an MSB3277 version-conflict warning. The app uses neither, so drop
       them before reference resolution to remove the conflict at its source. -->
  <Target Name="RemoveUnusedWebView2Assemblies" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)"
                 Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf' Or '%(Filename)' == 'Microsoft.Web.WebView2.WinForms'" />
    </ItemGroup>
  </Target>

  <!-- Trim the self-contained publish folder (packed verbatim by both the MSI and the portable zip) of runtime
       payload this app does not use - a further ~5.6 MB (~9%) on top of the ~40 MB of .pdb the switches above
       already drop. Each delete and its risk is documented in docs/aot.md:
         *.winmd - WinRT projection metadata. Under full AOT the projections are generated statically, so these are
                   normally not loaded; activation CAN fall back to them, so this prune is runtime-verified
                   (smoke-test every dialog/picker/template path after touching it).
         *.mui   - Win32 satellites localizing built-in WinUI control chrome (textbox menus, Narrator) per display
                   language. Keep only en-us to match the app's English UI; on non-English Windows that chrome falls
                   back to the base resources - no functional change. Re-add a culture's folder if the app is ever
                   localized to it.
         tile PNGs / Microsoft.UI.Designer.dll - MSIX tile art (unread by an unpackaged app) and the design-time
                   XAML designer (never loaded by the shipped app).
         runtimes\ - the SDK flattens RID-native DLLs to the publish root (where Win32 LoadLibrary resolves them),
                   so runtimes\<rid>\native\ is a redundant build-layout copy never loaded at runtime in a
                   self-contained AOT app (no deps.json probes it). Today that is just a duplicate
                   WebView2Loader.dll; the loaded copy in the root is kept.
         *.pdb   - belt-and-suspenders; the switches above already stop these from being copied. -->
  <Target Name="TrimPublishOutput" AfterTargets="Publish">
    <ItemGroup>
      <_PublishWinmd Include="$(PublishDir)*.winmd" />
      <_PublishMui Include="$(PublishDir)**\*.mui" Exclude="$(PublishDir)en-us\**\*.mui" />
      <_PublishDesignTime Include="$(PublishDir)Microsoft.UI.Designer.dll" />
      <_PublishPdb Include="$(PublishDir)**\*.pdb" />
      <_PublishTileAssets Include="$(PublishDir)Assets\LockScreenLogo*.png;
                                   $(PublishDir)Assets\SplashScreen*.png;
                                   $(PublishDir)Assets\Square150x150Logo*.png;
                                   $(PublishDir)Assets\Square44x44Logo*.png;
                                   $(PublishDir)Assets\StoreLogo*.png;
                                   $(PublishDir)Assets\Wide310x150Logo*.png" />
    </ItemGroup>
    <Delete Files="@(_PublishWinmd);@(_PublishMui);@(_PublishDesignTime);@(_PublishPdb);@(_PublishTileAssets)" />
    <!-- Remove the now-empty non-en-us culture folders the .mui files lived in. -->
    <RemoveDir Directories="@(_PublishMui->'%(RootDir)%(Directory)'->Distinct())" />
    <!-- Remove the redundant RID-native copies; the needed natives are flattened to the publish root. -->
    <RemoveDir Directories="$(PublishDir)runtimes" />
  </Target>
</Project>
