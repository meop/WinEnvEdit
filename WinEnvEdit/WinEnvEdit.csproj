<Project Sdk="Microsoft.NET.Sdk">

  <!-- App identity & target platform -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>WinEnvEdit</AssemblyName>
    <Company>meop</Company>
    <Description>Modern Windows Environment Editor</Description>
    <ApplicationIcon>Assets\App.ico</ApplicationIcon>
    <ApplicationManifest>App.manifest</ApplicationManifest>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <Platforms>ARM64;x64</Platforms>
    <RuntimeIdentifiers>win-arm64;win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <!-- Language & compiler -->
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Custom entry point (Program.Main) so an elevated relaunch can apply system vars headless. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <!-- WinUI / Windows App SDK (mode-independent) -->
  <PropertyGroup>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WinUISDKReferences>true</WinUISDKReferences>
    <WebView2EnableCsWinRTProjection>false</WebView2EnableCsWinRTProjection>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKDeploymentManagerInitialize>false</WindowsAppSDKDeploymentManagerInitialize>
  </PropertyGroup>

  <!-- Deployment toggles: self-contained + Native AOT (set both false for the framework-dependent MSI) -->
  <PropertyGroup>
    <SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <!-- Derived from the toggles above (separate group so the conditions see the values set above) -->
  <PropertyGroup>
    <WindowsAppSDKSelfContained>$(SelfContained)</WindowsAppSDKSelfContained>
    <!-- self-contained bundles the runtime; the bootstrapper hunts for an installed one and fail-fasts (0xC0000602) -->
    <WindowsAppSDKBootstrapInitialize Condition="'$(SelfContained)' == 'true'">false</WindowsAppSDKBootstrapInitialize>
    <WindowsAppSDKBootstrapInitialize Condition="'$(SelfContained)' != 'true'">true</WindowsAppSDKBootstrapInitialize>
    <!-- AOT needs the CsWinRT optimizer; level 2 surfaces all AOT/trim binding warnings at build -->
    <CsWinRTAotOptimizerEnabled Condition="'$(PublishAot)' == 'true'">true</CsWinRTAotOptimizerEnabled>
    <CsWinRTAotWarningLevel Condition="'$(PublishAot)' == 'true'">2</CsWinRTAotWarningLevel>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>

  <!-- Release publish hygiene: stop the build from emitting/copying companion files we would only strip again.
       DebugType/DebugSymbols suppress the managed .pdb; AllowedReferenceRelatedFileExtensions stops the SDK from
       copying the .pdb/.xml that sit next to referenced assemblies. The Native AOT .pdb is produced by the ILC
       compiler independently of these switches, so it is still removed by TrimPublishOutput below. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
    <!-- Stop the Native AOT symbol file (the ~40 MB WinEnvEdit.pdb) from being copied into the publish folder.
         This gates the SDK's _CopyAotSymbols target, which runs AFTER our TrimPublishOutput below - so deleting
         the pdb there is too early; it gets re-copied. Suppressing it at the source is the correct fix. -->
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>WinEnvEdit.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <None Include="..\LICENSE.txt">
      <Link>LICENSE.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinEnvEdit.Core\WinEnvEdit.Core.csproj" />
  </ItemGroup>

  <!-- Bindings are made AOT-safe with the CsWinRT source generators ([GeneratedBindableCustomProperty],
       x:Bind). Those do NOT cover types reached only dynamically (code-hosted DataTemplates, converters and
       markup extensions resolved via XAML) — full trim strips them (e.g. path rows render as ToString()).
       WinUI offers no per-type alternative, so root the two small app assemblies: robust (covers every
       XAML-reached type) and cheap (the bulk of the bundle is the native WinUI runtime, which still trims). -->
  <ItemGroup Condition="'$(PublishAot)' == 'true'">
    <TrimmerRootAssembly Include="WinEnvEdit" />
    <TrimmerRootAssembly Include="WinEnvEdit.Core" />
  </ItemGroup>

  <!-- WinUI uses only the Core WebView2 assembly; the transitive WPF/WinForms WebView2 assemblies are built
       against legacy WindowsBase and cause an MSB3277 version-conflict warning. The app uses neither, so drop
       them before reference resolution to remove the conflict at its source. -->
  <Target Name="RemoveUnusedWebView2Assemblies" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)"
                 Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf' Or '%(Filename)' == 'Microsoft.Web.WebView2.WinForms'" />
    </ItemGroup>
  </Target>

  <!-- Keep release artifacts minimal by stripping files that are never used at runtime from the publish folder.
       Both the MSI and the portable zip pack this same folder, so pruning it once is the single source of truth.
       The build switches above are the primary mechanism (they stop the .pdb/.xml from being produced or copied,
       including the ~40 MB Native AOT pdb); the deletes below are belt-and-suspenders for whatever still slips
       through (e.g. a .xml copied as package content rather than a reference companion). Removed, why each is safe:
         *.pdb  - debug symbols. Normally already gone via the switches above; deleted here only as a fallback.
         *.xml  - package XML doc files; consumed only by IDE tooling.
         *.mui  - Win32 satellites that localize built-in WinUI control chrome (TextBox context menu, Narrator)
                  into the display language. The app's UI is hardcoded English and the default control strings
                  ship in the .pri files (kept), so even en-us is droppable. The empty culture folders go too.
         Microsoft.UI.Designer.dll - the XAML designer; design-time only, never loaded by the shipped app.
         MSIX tile assets - Square*/Wide*/SplashScreen/StoreLogo/LockScreen PNGs are read only from an MSIX
                  manifest. This app is unpackaged (WindowsPackageType=None), so nothing loads them; App.ico
                  (the exe icon + WiX shortcut icon) is kept.
       See docs/aot.md. NOTE: the 25 *.winmd files (~2 MB) are a further candidate but need a manual runtime
       pass (activation can fall back to them), so they are deliberately left in. -->
  <Target Name="TrimPublishOutput" AfterTargets="Publish">
    <ItemGroup>
      <_PublishPdb Include="$(PublishDir)**\*.pdb" />
      <_PublishXml Include="$(PublishDir)**\*.xml" />
      <_PublishMui Include="$(PublishDir)**\*.mui" />
      <_PublishDesignTime Include="$(PublishDir)Microsoft.UI.Designer.dll" />
      <_PublishTileAssets Include="$(PublishDir)Assets\LockScreenLogo*.png;
                                   $(PublishDir)Assets\SplashScreen*.png;
                                   $(PublishDir)Assets\Square150x150Logo*.png;
                                   $(PublishDir)Assets\Square44x44Logo*.png;
                                   $(PublishDir)Assets\StoreLogo*.png;
                                   $(PublishDir)Assets\Wide310x150Logo*.png" />
    </ItemGroup>
    <Delete Files="@(_PublishPdb);@(_PublishXml);@(_PublishMui);@(_PublishDesignTime);@(_PublishTileAssets)" />
    <!-- Remove the now-empty culture folders the .mui files lived in (never the publish root: no .mui there). -->
    <RemoveDir Directories="@(_PublishMui->'%(RootDir)%(Directory)'->Distinct())" />
  </Target>
</Project>
